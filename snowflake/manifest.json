{
  "name": "snowflake-client",
  "buildsystem": "simple",
  "build-options": {
    "append-path": "/usr/lib/sdk/golang/bin",
    "env": {
      "GOBIN": "/app/bin",
      "GOROOT": "/usr/lib/sdk/golang"
    }
  },
  "build-commands": [
    "cd client && go build -mod=vendor -o snowflake-client",
    "install -Dm755 client/snowflake-client -t ${FLATPAK_DEST}/snowflake/pts"
  ],
  "sources": [
    {
      "type": "archive",
      "url": "https://gitlab.torproject.org/tpo/anti-censorship/pluggable-transports/snowflake/-/archive/v2.15.3/snowflake-v2.15.3.tar.gz",
      "sha256": "a78196e776297ef127122a84d0be691ec978d8263bc97f773e553be042632e57"
    },
    "go.mod.yml"
  ]
}
