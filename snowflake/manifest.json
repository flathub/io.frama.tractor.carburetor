{
  "name": "snowflake-client",
  "buildsystem": "simple",
  "build-options": {
    "append-path": "/usr/lib/sdk/golang/bin",
    "env": {
      "GOBIN": "/app/bin",
      "GOROOT": "/usr/lib/sdk/golang"
    }
  },
  "build-commands": [
    "cd client && go build -mod=vendor -o snowflake-client",
    "install -Dm755 client/snowflake-client -t ${FLATPAK_DEST}/snowflake/pts"
  ],
  "sources": [
    {
      "type": "archive",
      "url": "https://gitlab.torproject.org/tpo/anti-censorship/pluggable-transports/snowflake/-/archive/v2.14.1/snowflake-v2.14.1.tar.gz",
      "sha256": "39aa853c9bf966ac606456b4f357631470b4bee970e256a20eab54cba8a55d2f"
    },
    "go.mod.yml"
  ]
}
